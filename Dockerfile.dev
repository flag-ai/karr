# Development image: dependencies baked in, source bind-mounted, uvicorn --reload.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir poetry==2.* \
    && poetry config virtualenvs.create false
WORKDIR /app
COPY pyproject.toml poetry.lock README.md ./
RUN poetry install --no-interaction --no-ansi --without dev --no-root
RUN groupadd --gid 1000 karr && useradd --uid 1000 --gid karr --create-home karr
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
USER karr
EXPOSE 8080
# Source is bind-mounted read-only at runtime; the ASGI module reads the same
# env as `karr serve`. The package is not installed (--no-root), so the version
# reports as "dev".
CMD ["uvicorn", "karr.asgi:app", "--host", "0.0.0.0", "--port", "8080", "--reload", "--reload-dir", "/app/src", "--no-server-header"]
