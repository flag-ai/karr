# Copy to .env for local development. Never commit .env.
# docker compose reads this file too: POSTGRES_PASSWORD and GF_ADMIN_PASSWORD
# are for the postgres and grafana services there.
DATABASE_URL=postgresql://karr:karr-dev@localhost:5432/karr
POSTGRES_PASSWORD=karr-dev
GF_ADMIN_PASSWORD=
LISTEN_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
KARR_ADMIN_TOKEN=
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
KARR_SECRET_KEY=
KARR_CORS_ORIGINS=http://localhost:5173
KARR_TRUSTED_PROXIES=
KARR_REGISTRATION_TTL=3600
KARR_DEFAULT_AGENT_URL=
KARR_DEFAULT_AGENT_TOKEN=
# Public https base URL embedded in install scripts (required for provisioning;
# the request's Host header is never used for this). Leave empty until set.
KARR_PUBLIC_URL=
# Proxies whose X-Forwarded-For is trusted; rate limits key on the direct peer
# otherwise, so set this whenever KARR sits behind a reverse proxy

# Background reconciliation of environment status against BONNIE: seconds
# between passes, and the per-agent budget for one pass
KARR_RECONCILE_INTERVAL=30
KARR_RECONCILE_TIMEOUT=20
KARR_ENABLE_HSTS=false
# Only for labs without TLS: lets install scripts phone home over plain http
KARR_ALLOW_INSECURE_INSTALL=false
