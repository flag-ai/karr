# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://karr:karr-dev@localhost:5432/karr
LISTEN_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
KARR_ADMIN_TOKEN=
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
KARR_SECRET_KEY=
KARR_CORS_ORIGINS=http://localhost:5173
KARR_TRUSTED_PROXIES=
KARR_REGISTRATION_TTL=3600
KARR_DEFAULT_AGENT_URL=
KARR_DEFAULT_AGENT_TOKEN=
# Public base URL embedded in install scripts (else detected from trusted proxies)
KARR_PUBLIC_URL=
KARR_ENABLE_HSTS=false
